{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "state_epoch": {
      "type": "string",
      "format": "uuid"
    },
    "config_version": {
      "type": "integer",
      "minimum": 1
    },
    "collection_started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "start_date",
        "end_date"
      ]
    },
    "result": {
      "enum": [
        "complete",
        "partial",
        "empty"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 0,
      "maxItems": 20
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "minItems": 0,
      "maxItems": 500
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      },
      "minItems": 0,
      "maxItems": 500
    }
  },
  "required": [
    "protocol_version",
    "batch_id",
    "state_epoch",
    "config_version",
    "collection_started_at",
    "generated_at",
    "window",
    "result",
    "warnings",
    "events",
    "candidates"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "兴趣日历批次协议 1.0（设计契约）",
  "$comment": "本Schema仅处理结构和基础格式。时间先后、窗口交集、IANA时区、当前epoch/配置/对象版本、重复操作、数组合计500条及来源冲突等由服务端语义校验。必须启用format校验。",
  "$defs": {
    "source_key": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "namespace",
        "id"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "format": "uri",
          "pattern": "^https?://"
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "source_timezone": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "verified_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      },
      "required": [
        "url",
        "excerpt",
        "source_timezone",
        "verified_at"
      ]
    },
    "timing": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "timed"
            },
            "start": {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "end": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "start",
            "end"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "date"
            },
            "start_date": {
              "type": "string",
              "format": "date"
            },
            "end_date_exclusive": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "kind",
            "start_date",
            "end_date_exclusive"
          ]
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "base_version": {
          "type": "integer",
          "minimum": 0
        },
        "source_key": {
          "$ref": "#/$defs/source_key"
        },
        "interest_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 0,
          "maxItems": 50,
          "uniqueItems": true
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "location": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "status": {
          "enum": [
            "confirmed",
            "cancelled"
          ]
        },
        "timing": {
          "$ref": "#/$defs/timing"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 10
        }
      },
      "required": [
        "event_id",
        "base_version",
        "source_key",
        "interest_ids",
        "title",
        "location",
        "status",
        "timing",
        "evidence"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "event_id": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "base_version": {
                "const": 0
              },
              "interest_ids": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "base_version": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_candidate_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "base_candidate_version": {
          "type": "integer",
          "minimum": 0
        },
        "related_event_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "base_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "interest_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true
        },
        "reason": {
          "enum": [
            "uncertain_date",
            "conflicting_sources",
            "possible_duplicate",
            "insufficient_evidence",
            "postponed"
          ]
        },
        "proposed_event": {
          "anyOf": [
            {
              "$ref": "#/$defs/event"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 0,
          "maxItems": 10
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "client_candidate_id",
        "base_candidate_version",
        "related_event_id",
        "base_version",
        "title",
        "interest_ids",
        "reason",
        "proposed_event",
        "evidence",
        "notes"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "related_event_id": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "base_version": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "base_version": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "postponed"
              }
            }
          },
          "then": {
            "properties": {
              "related_event_id": {
                "type": "string",
                "format": "uuid"
              },
              "base_version": {
                "type": "integer",
                "minimum": 1
              },
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "empty"
          }
        }
      },
      "then": {
        "properties": {
          "events": {
            "maxItems": 0
          },
          "candidates": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "partial"
          }
        }
      },
      "then": {
        "properties": {
          "warnings": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
